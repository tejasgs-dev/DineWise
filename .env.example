# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM (Groq) -------------------------------------------------------------
# Required for AI ranking. Without it the app still runs and returns
# heuristic (rule-based) results flagged as degraded.
GROQ_API_KEY=

# Models must support strict JSON-schema output on Groq
DINEWISE_MODEL=openai/gpt-oss-120b
# Tried once if the primary model gives no usable answer; empty disables it
DINEWISE_FALLBACK_MODEL=openai/gpt-oss-20b
# low, medium, or high
DINEWISE_REASONING_EFFORT=low
DINEWISE_LLM_MAX_COMPLETION_TOKENS=1200
# Per HTTP request, and for the whole LLM step (retries + fallback)
DINEWISE_LLM_TIMEOUT_S=30
DINEWISE_LLM_DEADLINE_S=20

# --- Retrieval --------------------------------------------------------------
DINEWISE_SHORTLIST_SIZE=10
DINEWISE_MIN_CANDIDATES=5
# Max branches of one chain in a shortlist
DINEWISE_MAX_BRANCHES_PER_CHAIN=2
# Fuzzy-match score (0-100) needed to accept a misspelled location or cuisine
DINEWISE_FUZZY_MATCH_THRESHOLD=85

# Budget bands, cost for two in INR: low <= LOW_MAX < medium <= MEDIUM_MAX < high
DINEWISE_BUDGET_LOW_MAX=400
DINEWISE_BUDGET_MEDIUM_MAX=1000

# Heuristic pre-score weights (must sum to 1.0)
DINEWISE_WEIGHT_RATING=0.45
DINEWISE_WEIGHT_VOTES=0.25
DINEWISE_WEIGHT_CUISINE=0.15
DINEWISE_WEIGHT_TAGS=0.15

# --- API --------------------------------------------------------------------
# Browser origins allowed to call the API, as a JSON list
DINEWISE_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
# Also allow origins matching this regex (e.g. Vercel preview deployments); empty = off
# DINEWISE_CORS_ORIGIN_REGEX=^https://dinewise(-[a-z0-9-]+)?\.vercel\.app$
# Reject request bodies larger than this (bytes)
DINEWISE_MAX_REQUEST_BYTES=16384
# Recommendation requests per client IP per minute; 0 disables the limit
DINEWISE_RATE_LIMIT_PER_MINUTE=10
# Trusted proxies that append to X-Forwarded-For (0 = reached directly; 1 on Render)
DINEWISE_FORWARDED_HOPS=0
# DEBUG, INFO, WARNING, ERROR
DINEWISE_LOG_LEVEL=INFO
# json (one JSON object per line) or text
DINEWISE_LOG_FORMAT=json

# --- UI (Streamlit) ---------------------------------------------------------
# Read by the Streamlit app from its own environment (not from this file);
# set them in the shell or container that runs `streamlit run`.
# DINEWISE_API_URL=http://127.0.0.1:8000
# Seconds to wait for a recommendation; keep it above DINEWISE_LLM_DEADLINE_S
# DINEWISE_UI_TIMEOUT_S=60

# --- Data -------------------------------------------------------------------
DINEWISE_DATA_PATH=data/restaurants.parquet
DINEWISE_META_PATH=data/meta.json
DINEWISE_RAW_DIR=data/raw
DINEWISE_HF_DATASET=ManikaSaini/zomato-restaurant-recommendation
# Dataset revision (commit hash or tag), pinned for reproducible builds; empty = latest
DINEWISE_HF_REVISION=5738e9eda2fad49ad51c6e0ed26e761d9b947133
